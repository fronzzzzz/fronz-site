# Customer.io Tracking API — powers the lead form (app/api/lead) and the
# /map "send your map" capture (app/api/starter). Use the FRONZ workspace's
# keys: Customer.io → Settings → API Credentials → Tracking API Keys.
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=
# Set to "eu" if your Customer.io workspace is in the EU region; otherwise "us".
CUSTOMERIO_REGION=us

# Duplicatable "work in it" templates shown on /map. These have live
# defaults in lib/content.ts (public share links, not secrets); only set these
# to override per-environment.
# Default in lib/content.ts if unset:
# https://www.notion.so/3d6ebef38005806da346d8810eb980f5?source=copy_link
NEXT_PUBLIC_STARTER_NOTION_TEMPLATE_URL=

# Mirror submitted GTM Clarity Map submissions into Fronz Notion.
# Required on Vercel (Production + Preview) or /api/starter returns notionSaved: false.
# NOTION_TOKEN: the FRONZ Notion internal integration token (starts "ntn_").
# NOTION_STARTER_PARENT_ID: the "GTM Clarity Starter — Submissions" page id.
#   https://app.notion.com/p/GTM-Clarity-Starter-Submissions-3898234f4e908171bfaaf5c46ffc3e04
# NOTION_STARTER_DATABASE_ID: run `node scripts/setup-notion-starter-db.mjs` once
#   to create the database; submissions then write rows instead of loose pages.
NOTION_TOKEN=
NOTION_STARTER_PARENT_ID=3898234f-4e90-8171-bfaa-f5c46ffc3e04
NOTION_STARTER_DATABASE_ID=

# Calendly inline embed on /book (includes brand color query params).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/fronzzz/map-review?background_color=f3efe4&text_color=1c1e17&primary_color=1c1e17

# Hosted Stripe invoice on /deliverables/jupiterblock-intensive.
# Default lives in lib/deliverables/jupiterblock-intensive.ts; set this if you reissue.
NEXT_PUBLIC_JUPITERBLOCK_INVOICE_URL=
